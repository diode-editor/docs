---
// Layout in the manner of the VS Code docs: the landing page's full-width header, then one
// centered column (the header's --page-max) holding the navigation, the page and its outline.
// Starlight's own frame pins the sidebar to the viewport edge instead.
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page">
    <div class="chrome"><slot name="header" /></div>
    <div class="frame">
        {
            hasSidebar && (
                <nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
                    <MobileMenuToggle />
                    <script>
                        // Starlight's mobile menu: a popover below 50em, a plain column above.
                        class StarlightSidebarPane extends HTMLElement {
                            constructor() {
                                super();
                                const desktop = matchMedia("(min-width: 50em)");
                                const reset = () => {
                                    this.popover = desktop.matches ? null : "auto";
                                };
                                reset();
                                desktop.addEventListener("change", reset);
                                this.addEventListener("toggle", ({ newState }) => this.trapFocus(newState === "open"));
                            }
                            trapFocus(shouldTrap: boolean) {
                                document.querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link").forEach((el) => {
                                    el.toggleAttribute("inert", shouldTrap);
                                });
                            }
                        }
                        customElements.define("sl-sidebar-pane", StarlightSidebarPane);
                    </script>
                    <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
                        <div class="sidebar-content sl-flex">
                            <slot name="sidebar" />
                        </div>
                    </sl-sidebar-pane>
                </nav>
            )
        }
        <div class="main-frame"><slot /></div>
    </div>
</div>

<style>
    .page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
    .chrome {
        position: sticky;
        top: 0;
        z-index: var(--sl-z-index-navbar);
    }
    .frame {
        flex: 1;
        width: 100%;
        max-width: var(--page-max);
        margin: 0 auto;
    }
    .main-frame {
        min-width: 0;
    }

    /* Narrow: the sidebar is a full-screen popover under the header. */
    .sidebar-pane {
        border: unset;
        padding: unset;
        height: unset;
        color: unset;
        position: fixed;
        z-index: var(--sl-z-index-menu);
        inset-block: var(--sl-nav-height) 0;
        inset-inline: 0;
        width: 100%;
        background-color: var(--sl-color-bg);
        overflow-y: auto;
    }
    .sidebar-content {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem 24px;
        min-height: max-content;
    }

    @media (min-width: 50rem) {
        .frame {
            display: grid;
            grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
            padding: 0 34px;
        }
        .sidebar-pane {
            display: block;
            position: sticky;
            top: var(--sl-nav-height);
            height: calc(100vh - var(--sl-nav-height));
            width: auto;
            background: none;
            border-inline-end: 1px solid var(--border-hairline);
            scrollbar-width: thin;
        }
        .sidebar-content {
            padding: 1.5rem 1.25rem 2rem 0;
        }
    }
</style>
