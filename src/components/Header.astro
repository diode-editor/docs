---
// The landing page's header, one to one (diode-editor.github.io index.html, the same as the
// marketplace's Header.tsx). Search lives at the top of the sidebar so the header stays identical.
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
---

<header class="site-header">
    <div class="wrap">
        <a class="brand" href="/">
            <svg class="mark" width="16" height="14" viewBox="0 0 16 14" aria-hidden="true">
                <path d="M2 7h3M11 7h3" stroke="currentColor" stroke-width="1.4"></path>
                <path d="M5 2.2 5 11.8 11 7Z" fill="currentColor"></path>
                <path d="M11 2.2v9.6" stroke="currentColor" stroke-width="1.6"></path>
            </svg>diode
        </a>
        <nav class="site-nav print:hidden">
            <a href="/marketplace/">extensions</a>
            <a href={import.meta.env.BASE_URL}>docs</a>
            <a href="https://github.com/diode-editor/diode">source</a>
            <ThemeSelect />
        </nav>
    </div>
</header>

<style>
    .site-header {
        background: var(--surface-chrome);
        border-bottom: 1px solid var(--border-hairline);
        font-size: 13px;
    }
    .wrap {
        max-width: var(--page-max);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 34px; /* 18 + 16 (lockup) + 18 = 52px */
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-strong);
        font-weight: 700;
        letter-spacing: 0.02em;
        text-decoration: none;
        line-height: 16px;
    }
    .mark {
        color: var(--accent);
        display: block;
        flex: none;
    }
    .site-nav {
        display: flex;
        gap: 26px;
        align-items: center;
        color: var(--text-muted);
        height: 16px;
    }
    .site-nav a {
        color: inherit;
        text-decoration: none;
    }
    .site-nav a:hover {
        color: var(--text-strong);
    }
    @media (max-width: 720px) {
        .wrap {
            padding-left: 24px;
            padding-right: 24px;
        }
    }
    /* Narrow screens: the links move into the menu (MobileMenuFooter), the menu button takes their place. */
    @media (max-width: 49.99rem) {
        .site-nav {
            display: none;
        }
    }
</style>
