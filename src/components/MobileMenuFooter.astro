---
// Narrow screens: the header's links live here, under the navigation.
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
---

<div class="mobile-links">
    <a href="/">home</a>
    <a href="/marketplace/">extensions</a>
    <a href="https://github.com/diode-editor/diode">source</a>
    <ThemeSelect />
</div>

<style>
    .mobile-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 26px;
        padding: 1rem 0;
        border-top: 1px solid var(--border-hairline);
        font-size: 13px;
        color: var(--text-muted);
    }
    .mobile-links a {
        color: inherit;
        text-decoration: none;
    }
</style>
